# BasicImageFlow

main: kit: flow: BasicImageFlow:
{
  entity: "image",
  kind: "basic",
  name: "BasicImageFlow",
  step: [
    {
      i: {
        ref: "image_ref01",
        srcdatavar: "image_ref01_data",
        suffix: "_up0",
        textfield: "etag"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-image_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "image_ref01",
        srcdatavar: "image_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "image01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-image_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicImageFlow"
}